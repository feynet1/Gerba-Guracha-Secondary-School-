rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return isAuthenticated() && request.auth.token.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function canReadSchoolRecords() {
      return hasRole(['admin', 'registrar', 'director']);
    }

    function canReadPhase3Administration() {
      return hasRole(['admin', 'director']);
    }

    function isTeacher() {
      return hasRole(['teacher']);
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    match /students/{studentId} {
      allow get: if canReadSchoolRecords();
      allow list: if canReadSchoolRecords();
      allow create, update, delete: if false;
    }

    match /parents/{parentId} {
      allow get: if canReadSchoolRecords()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if canReadSchoolRecords();
      allow create, update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if canReadSchoolRecords();
      allow create, update, delete: if false;
    }

    match /admissionNumbers/{admissionId} {
      allow read, write: if false;
    }

    match /classKeys/{classKey} {
      allow read, write: if false;
    }

    match /accountLinks/{userId} {
      allow read, write: if false;
    }

    match /teachers/{teacherId} {
      allow get: if canReadPhase3Administration()
        || (isTeacher() && resource.data.userId == request.auth.uid);
      allow list: if canReadPhase3Administration();
      allow create, update, delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if hasRole(['admin', 'director', 'teacher']);
      allow create, update, delete: if false;
    }

    match /teacherAssignments/{assignmentId} {
      allow get: if canReadPhase3Administration()
        || (isTeacher()
          && get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.type == 'teacher'
          && resource.data.teacherId == get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.recordId);
      allow list: if canReadPhase3Administration()
        || (isTeacher()
          && get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.type == 'teacher'
          && resource.data.teacherId == get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.recordId);
      allow create, update, delete: if false;
    }

    match /timetable/{entryId} {
      allow get, list: if canReadPhase3Administration()
        || (isTeacher()
          && get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.type == 'teacher'
          && resource.data.teacherId == get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.recordId);
      allow create, update, delete: if false;
    }

    match /schoolSettings/{settingsId} {
      allow read: if hasRole(['admin', 'director', 'teacher']);
      allow create, update, delete: if false;
    }

    match /employeeIds/{employeeKey} {
      allow read, write: if false;
    }

    match /subjectCodes/{subjectKey} {
      allow read, write: if false;
    }

    match /teacherAssignmentKeys/{assignmentKey} {
      allow read, write: if false;
    }

    match /timetableSlotLocks/{slotKey} {
      allow read, write: if false;
    }

    match /assignmentScheduleUsage/{assignmentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
