rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return isAuthenticated() && request.auth.token.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function canReadSchoolRecords() {
      return hasRole(['admin', 'registrar', 'director']);
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    match /students/{studentId} {
      allow get: if canReadSchoolRecords();
      allow list: if canReadSchoolRecords();
      allow create, update, delete: if false;
    }

    match /parents/{parentId} {
      allow get: if canReadSchoolRecords()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if canReadSchoolRecords();
      allow create, update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if canReadSchoolRecords();
      allow create, update, delete: if false;
    }

    match /admissionNumbers/{admissionId} {
      allow read, write: if false;
    }

    match /classKeys/{classKey} {
      allow read, write: if false;
    }

    match /accountLinks/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
